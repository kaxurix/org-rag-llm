# Paths are relative to the project directory.
DATA_DIR=data
DATASET_DIR=.
DATASET_GLOB=NOTULA RABES STECH 2026 *.pdf
AUTO_IMPORT=true
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=300

# auto: selected provider with extractive fallback; extractive: quotes only;
# gemini / ollama: force provider and return HTTP 503 if unavailable.
ANSWER_MODE=auto
LLM_PROVIDER=gemini
# Create a key in a Free-tier project: https://aistudio.google.com/apikey
# Free quota is limited; no automatic switch to a paid provider/model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=40
GEMINI_MAX_TOKENS=2048

# Optional local provider: LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=25
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_MAX_TOKENS=256
OLLAMA_MAX_SOURCES=4
OLLAMA_SOURCE_CHARS=650
OLLAMA_KEEP_ALIVE=30m
OLLAMA_PRELOAD=true

# Optional: install requirements-semantic.txt first.
# Reindex after changing models: python ingest.py --reindex
SEMANTIC_SEARCH=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_LOCAL_ONLY=true

# Optional: require X-API-Key for access to archive data.
API_KEY=
